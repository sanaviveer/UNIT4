#include <stdio.h>

union Data
{
int integer;

float decimal;
char character;
};

int main()
{
union Data data;

printf("Size of union = %lu bytes\n", sizeof(data));

data.integer = 100;

printf("\nAfter storing integer:"\n);
printf("Integer = %d\n"&, data.integer);

data.decimal = 25.5;

printf(\n"After storing float:"\n);
printf("Float = %.2f\n", data.decimal);

data.character = 'A';

printf(\n"After storing character:"\n);
printf("Character = %c\n", data.character);

printf(\n"Memory addresses of union members:"\n);

printf("Address of integer = %p\n&quot";, (void *)&data.integer);
printf("Address of float = %p\n&quot";, (void *)&data.decimal);
printf("Address of character = %p\n&quot";, (void *)&data.character);

return 0;
}
